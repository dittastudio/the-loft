{
  "name": "the-loft",
  "type": "module",
  "private": true,
  "author": "ditta",
  "scripts": {
    "sb:schema-init": "storyblok schema init --space 296151434062627",
    "sb:schema-validate": "storyblok schema validate .storyblok/schema/schema.ts",
    "sb:schema-diff": "storyblok schema push .storyblok/schema/schema.ts --space 296151434062627 --dry-run",
    "sb:schema-push": "storyblok schema push .storyblok/schema/schema.ts --space 296151434062627 --no-write-components",
    "sb:schema-rollback": "storyblok schema rollback --space 296151434062627",
    "sb:migrations-generate": "storyblok migrations generate --space 296151434062627",
    "sb:migrations-dry": "storyblok migrations run --space 296151434062627 --dry-run",
    "sb:migrations-run": "storyblok migrations run --space 296151434062627",
    "sb:migrations-rollback": "storyblok migrations rollback --space 296151434062627",
    "sb:login": "storyblok login",
    "sb:logout": "storyblok logout",
    "sb:help": "storyblok --help",
    "create:icons": "npx nuxt-seo-utils icons --source ./favicon.svg",
    "agent:readability": "npx @vercel/agent-readability audit https://the-loft.com",
    "agent:isAgentic": "npx is-agentic the-loft.com",
    "dev": "nuxt dev --host 0.0.0.0",
    "dev:ssl": "local-ssl-proxy --source 3010 --target 3000 --cert localhost.pem --key localhost-key.pem",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "nuke": "del-cli '.output' 'dist' '.nuxt' 'node_modules' 'package-lock.json'",
    "prepare": "vp config && husky"
  },
  "dependencies": {
    "nuxt": "^4.6.2",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@nuxt/fonts": "^1.2.0",
    "@nuxt/image": "^2.2.0",
    "@nuxtjs/seo": "^6.0.1",
    "@storyblok/nuxt": "^11.3.0",
    "@storyblok/schema": "^0.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^26.6.5",
    "del-cli": "^8.0.1",
    "husky": "^9.1.7",
    "nuxt-ai-ready": "^3.4.0",
    "postcss-nested": "^9.0.1",
    "postcss-utopia": "^1.1.0",
    "rolldown": "^1.2.15",
    "storyblok": "^4.25.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite-plus": "^1.4.0",
    "vite-svg-loader": "^5.1.3"
  }
}
