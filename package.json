{
  "name": "ditta-nuxt-storyblok-starter",
  "type": "module",
  "private": true,
  "author": "ditta",
  "scripts": {
    "sb:login": "storyblok login",
    "sb:logout": "storyblok logout",
    "sb:help": "storyblok --help",
    "sb:components": "storyblok components pull --space <STORYBLOK_SPACE_ID> --verbose",
    "sb:types": "storyblok types generate --space <STORYBLOK_SPACE_ID> --strict",
    "sb:generate": "npm run sb:components && npm run sb:types",
    "create:favicons": "npx nuxt-seo-utils icons --source ./favicon.svg",
    "agent:readability": "npx @vercel/agent-readability audit <APP_SITE_URL>",
    "dev": "npm run sb:generate && nuxt dev --host 0.0.0.0",
    "dev:ssl": "local-ssl-proxy --source 3010 --target 3000 --cert localhost.pem --key localhost-key.pem",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "nuke": "del-cli '.output' 'dist' '.nuxt' 'node_modules' 'package-lock.json'",
    "prepare": "husky"
  },
  "dependencies": {
    "@nuxtjs/seo": "^5.3.14",
    "@storyblok/nuxt": "^11.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "nuxt": "^4.5.2",
    "postcss-nested": "^8.0.1",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/image": "^2.1.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^22.20.2",
    "del-cli": "^7.0.0",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "nuxt-ai-ready": "^2.3.2",
    "storyblok": "^4.22.4",
    "tailwind-merge": "^3.6.0",
    "typescript": "^7.0.2",
    "vite-plugin-devtools-json": "^1.1.0",
    "vite-svg-loader": "^5.1.3"
  }
}
